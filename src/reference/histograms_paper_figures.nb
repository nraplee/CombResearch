Cell[CellGroupData[{
Cell["Paper figures: p=3, q=3 pure simplicial complexes", "Title",ExpressionUUID->"11cbb387-8309-f940-b062-0dd57b07dc35"],

Cell["\<\
Produces the four histogram panels for Figure 2 of the paper.
Run histograms_handoff_v2.nb first to generate all distributions,
then run this notebook to produce paper-ready figures.\
\>", "Text",ExpressionUUID->"9156061f-e680-9140-a6b4-00ddd1d4b3d5"],

