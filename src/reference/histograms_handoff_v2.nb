 RowBox[{
  RowBox[{
   RowBox[{"$HistoryLength", " ", "=", " ", "0"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<ECGrav`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ParallelNeeds", "[", "\"\<ECGrav`\>\"", "]"}], ";"}]}], "Input",
