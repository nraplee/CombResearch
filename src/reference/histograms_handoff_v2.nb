Cell["Exact Facet-Labeled Enumeration (diagnostic sanity check)", "Section",ExpressionUUID->"9293ce34-c2f6-6449-9588-6f825f9430ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "This", " ", "block", " ", "verifies", " ", "that", " ", "the", " ", 
     "formula", " ", 
     RowBox[{
      RowBox[{"q", "!"}], "/"}]}], "|", "Aut_F", "|", " ", 
    RowBox[{"matches", " ", "the", " ", "exact", " ", 
     RowBox[{"enumeration", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"If", " ", "exact", " ", "matches", " ", 
     RowBox[{"formula", ":", " ", 
      RowBox[{"formula", " ", "is", " ", "correct"}]}]}], ",", " ", 
    RowBox[{"reweighting", " ", "approach", " ", "is", " ", 
     RowBox[{"validated", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"If", " ", "they", " ", 
    RowBox[{"differ", ":", " ", 
     RowBox[{
     "there", " ", "is", " ", "a", " ", "deeper", " ", "inconsistency", " ", 
      "that", " ", "needs", " ", 
      RowBox[{"investigation", "."}]}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{"runExactFacetEnumeration", ",", "\n", "  ", 
     RowBox[{
      RowBox[{"exactFacetLabeled", " ", "=", " ", "allFacetLabeledForReps"}], 
      ";", "\n", "  ", 
      RowBox[{"exactFacetClasses", " ", "=", " ", 
       RowBox[{"ParallelMap", "[", 
        RowBox[{"classIndex", ",", " ", "exactFacetLabeled"}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"exactFacetEnumeratedDist", " ", "=", " ", 
       RowBox[{"classDistFromClasses", "[", "exactFacetClasses", "]"}]}], ";",
       "\n", "\n", "  ", 
      RowBox[{"facetComparisonTable", " ", "=", " ", 
       RowBox[{"Prepend", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"Table", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"{", "\n", "        ", 
            RowBox[{"i", ",", "\n", "        ", 
             RowBox[{"N", "[", 
              RowBox[{"exactFacetEnumeratedDist", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", "\n", 
             "        ", 
             RowBox[{"N", "[", 
              RowBox[{"facetTheoryFormulaDist", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", "\n", 
             "        ", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"exactFacetEnumeratedDist", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
               RowBox[{"facetTheoryFormulaDist", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], "\n", 
            "      ", "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", "numClasses"}], "}"}]}], 
          "\n", "    ", "]"}], ",", "\n", "    ", 
         RowBox[{"{", "\n", "      ", 
          
          RowBox[{"\"\<classIndex\>\"", ",", "\n", 
           "      ", "\"\<exactFacetEnumeratedProbability\>\"", ",", "\n", 
           "      ", "\"\<facetTheoryFormulaProbability\>\"", ",", "\n", 
           "      ", "\"\<differenceExactMinusFormula\>\""}], "\n", "    ", 
          "}"}]}], "\n", "  ", "]"}]}], ";", "\n", "\n", "  ", 
      RowBox[{"facetComparisonGrid", " ", "=", " ", 
       RowBox[{"Grid", "[", 
        RowBox[{"facetComparisonTable", ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}], ";", "\n", "\n",
       "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Formula", " ", "vs", " ", 
         RowBox[{"exact", ":", " ", 
          RowBox[{
          "if", " ", "red", " ", "dots", " ", "and", " ", "blue", " ", "dots",
            " ", "coincide"}]}]}], ",", " ", 
        RowBox[{"formula", " ", "is", " ", "correct"}]}], " ", "*)"}], "\n", 
      "  ", 
      RowBox[{"facetFormulaVsExactPlot", " ", "=", " ", 
       RowBox[{"Show", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"makeTheoryPlot", "[", 
          RowBox[{"facetTheoryFormulaDist", ",", " ", "Red"}], "]"}], ",", 
