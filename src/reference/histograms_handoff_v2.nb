Cell[CellGroupData[{
Cell["Histogram workflow: p=3, q=3 pure simplicial complexes", "Title",ExpressionUUID->"ab2ff4b8-e628-d444-887b-41b6040e5e14"],

Cell["\<\
Arbitrary pure simplicial complexes, ordered by decreasing vertex labelings.
Facet-labeled distribution computed by reweighting vertex-labeled samples \
(paper Eq. 25).
Do NOT use RandomFacetLabeledPureSimplicialComplex -- it is not verified to \
be uniform.\
\>", "Text",ExpressionUUID->"34cb32f5-9000-084b-ac44-879d57cd69a8"],

