(* CreatedBy='pure_simplicial_figures.nb generator' *)

Notebook[{

Cell["Pure Simplicial Figures (Figures 3+)", "Title"],

Cell["Loads per-p sample CSVs produced by pure_simplicial_compute.wl and renders each paper figure as a 3x1 column grid (one panel per p in {2, 3, 4}). Each panel overlays three weighted histograms: vertex-labeled, facet-labeled, unlabeled. This notebook does not touch the figure-2 pipeline.", "Text"],

Cell[CellGroupData[{
Cell["Setup", "Section"],

Cell["ClearAll[\"Global`*\"];
$HistoryLength = 0;

qVal = 10;
pList = {2, 3, 4};
sampleSize = 10000;
exportFigures = True;
outputDir = NotebookDirectory[];

(* Colors: keep figure-2 palette and add a third for the unlabeled series *)
colorVertex    = RGBColor[0.984, 0.757, 0.369];  (* golden yellow *)
colorFacet     = RGBColor[0.122, 0.471, 0.706];  (* muted blue   *)
colorUnlabeled = RGBColor[0.890, 0.290, 0.200];  (* muted red    *)

seriesColors = {colorVertex, colorFacet, colorUnlabeled};
seriesNames  = {\"vertex-labeled\", \"facet-labeled\", \"unlabeled\"};

(* Shared frame/font options, matching histograms_paper_figures.nb *)
frameOpts = Sequence[
  Frame      -> True,
  FrameStyle -> Directive[Black, AbsoluteThickness[1]],
  LabelStyle -> Directive[FontFamily -> \"Times\", FontSize -> 11, Black],
  ImageSize  -> {360, 270},
  PlotRange  -> All,
  ImageMargins -> 5
];", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Load sample data", "Section"],

Cell["loadSamples[p_Integer] := Module[{path, raw, headers, body, cols, parseCol},
  path = FileNameJoin[{outputDir,
    \"p\" <> ToString[p] <> \"q\" <> ToString[qVal] <>
    \"_n\" <> ToString[sampleSize] <> \"_samples.csv\"}];
  If[!FileExistsQ[path],
    Print[\"Missing: \", path]; Return[$Failed]];
  raw = Import[path, \"CSV\"];
  headers = First[raw];
  body = Rest[raw];
  cols = Transpose[body];
  (* CSV parser: \"\"->Missing, stringified rationals (\"1/720\")->numeric Real,
     other strings/numbers passed through. *)
  parseCol[col_] := Map[Function[x, Which[
    x === \"\", Missing[],
    StringQ[x], N[ToExpression[x]],
    True, x]], col];
  AssociationThread[headers -> (parseCol /@ cols)]
];

sampleData = AssociationMap[loadSamples, pList];", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Helper functions", "Section"],

Cell["(* Filter mask: returns a list of True/False per sample.
   filterSpec is one of:
     None              - keep all
     \"connected\"     - keep only complexes with 1 vertex-connected component
*)
filterMask[s_Association, filterSpec_] := Switch[filterSpec,
  None, ConstantArray[True, Length[s[\"numV\"]]],
  \"connected\", # == 1 & /@ s[\"connected\"],
  _, ConstantArray[True, Length[s[\"numV\"]]]
];

(* Returns {WeightedData_vertex, WeightedData_facet, WeightedData_unlabeled}
   for the given column, after applying filter and dropping Missing entries. *)
weightedSeries[s_Association, col_String, filterSpec_:None] := Module[
  {mask, vals, wV, wF, wU, keep},
  mask = filterMask[s, filterSpec];
  vals = Pick[s[col], mask];
  wV = Pick[s[\"wVertex\"], mask];
  wF = Pick[s[\"wFacet\"], mask];
  wU = Pick[s[\"wUnlabeled\"], mask];
  keep = ! MissingQ[#] & /@ vals;
  vals = Pick[vals, keep];
  wV = Pick[wV, keep];
  wF = Pick[wF, keep];
  wU = Pick[wU, keep];
  If[Length[vals] == 0, Return[$Failed]];
  {WeightedData[vals, wV],
   WeightedData[vals, wF],
   WeightedData[vals, wU]}
];

(* Aggregate (value, weight) pairs by value; returns sorted {{v, prob}, ...}
   normalized so probabilities sum to 1. *)
weightedDist[vals_List, weights_List] := Module[{paired, agg, tot},
  paired = MapThread[List, {vals, weights}];
  agg = GroupBy[paired, First -> Last, Total];
  tot = Total[Values[agg]];
  SortBy[KeyValueMap[{#1, #2/tot} &, agg], First]
];", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Panel and figure builders", "Section"],

Cell["(* makePanel: one p-value, one statistic.
   panelType in {\"discrete\", \"logdiscrete\", \"continuous\"}.
   For \"discrete\": grouped BarChart at each integer x value.
   For \"logdiscrete\": one bar per decade of x value (for |Aut|, |Aut_F|).
   For \"continuous\": Histogram with shared bins, three overlaid series. *)

makePanel[p_Integer, col_String, xLabel_String, panelType_String,
          filterSpec_:None, opts___?OptionQ] := Module[
  {s = sampleData[p], series, vals, wV, wF, wU, dV, dF, dU,
   allX, mat, mask, keep},

  mask = filterMask[s, filterSpec];
  vals = Pick[s[col], mask];
  wV = Pick[s[\"wVertex\"], mask];
  wF = Pick[s[\"wFacet\"], mask];
  wU = Pick[s[\"wUnlabeled\"], mask];
  keep = ! MissingQ[#] & /@ vals;
  vals = Pick[vals, keep];
  wV = Pick[wV, keep]; wF = Pick[wF, keep]; wU = Pick[wU, keep];

  If[Length[vals] == 0,
    Return[Graphics[Text[Style[\"no data for p=\" <> ToString[p],
      \"Times\", 11, Gray]], frameOpts]]];

  Switch[panelType,
    \"discrete\",
    dV = weightedDist[vals, wV];
    dF = weightedDist[vals, wF];
    dU = weightedDist[vals, wU];
    allX = Sort[DeleteDuplicates[
      Join[dV[[All, 1]], dF[[All, 1]], dU[[All, 1]]]]];
    mat = Table[
      Lookup[Association @@ (Rule @@@ d), x, 0.],
      {x, allX}, {d, {dV, dF, dU}}];
    BarChart[mat,
      ChartLayout    -> \"Grouped\",
      ChartStyle     -> seriesColors,
      ChartLabels    -> {allX, None},
      ChartLegends   -> Placed[seriesNames, Top],
      FrameLabel     -> {{\"Probability\", None}, {xLabel, None}},
      PlotLabel      -> Style[\"p = \" <> ToString[p],
                         FontFamily -> \"Times\", FontSize -> 12, Bold],
      frameOpts, opts],

    \"logdiscrete\",
    Module[{logVals, lo, hi, nBins, binIdx, sumW, dists, labels},
      logVals = Log10[N[vals]];
      lo = Floor[Min[logVals]];
      hi = Ceiling[Max[logVals]];
      If[hi <= lo, hi = lo + 1];
      nBins = hi - lo;
      binIdx = Clip[Ceiling[(logVals - lo)], {1, nBins}];
      sumW[w_] := Module[{out = ConstantArray[0., nBins]},
        MapThread[(out[[#1]] += #2) &, {binIdx, w}]; out / Total[w]];
      dists = sumW /@ {wV, wF, wU};
      labels = Table[
        Style[Superscript[10, k], FontFamily -> \"Times\", FontSize -> 10],
        {k, lo, hi - 1}];
      BarChart[Transpose[dists],
        ChartLayout    -> \"Grouped\",
        ChartStyle     -> seriesColors,
        ChartLabels    -> {labels, None},
        ChartLegends   -> Placed[seriesNames, Top],
        FrameLabel     -> {{\"Probability\", None},
                           {xLabel <> \"  (per-decade bin)\", None}},
        PlotLabel      -> Style[\"p = \" <> ToString[p],
                           FontFamily -> \"Times\", FontSize -> 12, Bold],
        frameOpts, opts]],

    \"continuous\",
    Histogram[
      {WeightedData[vals, wV], WeightedData[vals, wF], WeightedData[vals, wU]},
      Automatic, \"PDF\",
      ChartStyle   -> seriesColors,
      ChartLegends -> Placed[seriesNames, Top],
      FrameLabel   -> {{\"Density\", None}, {xLabel, None}},
      PlotLabel    -> Style[\"p = \" <> ToString[p],
                       FontFamily -> \"Times\", FontSize -> 12, Bold],
      frameOpts, opts],

    _, Graphics[Text[\"unknown panelType\"], frameOpts]
  ]
];

(* makeFigure: stack panels for the given p values into a 3x1 column.
   Pass pSubset to restrict (e.g. {3,4} for 2-path, {4} for 3-path). *)
makeFigure[col_String, xLabel_String, panelType_String,
           pSubset_:Automatic, filterSpec_:None, opts___?OptionQ] := Module[
  {ps, panels},
  ps = If[pSubset === Automatic, pList, pSubset];
  panels = makePanel[#, col, xLabel, panelType, filterSpec, opts] & /@ ps;
  GraphicsGrid[List /@ panels,
    Spacings -> {0.3, 0.3},
    ImageSize -> {380, 290 * Length[ps]}]
];

(* exportFigure: render and write a PDF. *)
exportFigure[name_String, fig_] := If[exportFigures,
  Export[FileNameJoin[{outputDir, name <> \".pdf\"}], fig];
  Print[\"Exported: \", name <> \".pdf\"]];", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 3 - Number of vertices", "Section"],

Cell["fig3 = makeFigure[\"numV\", \"Number of vertices\", \"discrete\"];
exportFigure[\"fig3_numVertices\", fig3];
fig3", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 4 - Automorphism group order |Gamma(X)|", "Section"],

Cell["fig4 = makeFigure[\"aut\", \"|\\[CapitalGamma](X)|\", \"logdiscrete\"];
exportFigure[\"fig4_autOrder\", fig4];
fig4", "Input"]
}, Open]],

