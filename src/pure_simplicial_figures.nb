(*** Wolfram Notebook File ***)
(* http://www.wolfram.com/nb *)

(* CreatedBy='pure_simplicial_figures.nb generator' *)

Notebook[{

Cell["Pure Simplicial Figures (Figures 3-15)", "Title"],

Cell["Notebook version of render_all_figures.wl. Loads the per-p sample CSVs and renders each figure as a 3x1 stacked column of translucent overlaid weighted histograms, matching paper Figure 2 style. Each panel overlays three series on the same axes: vertex-labeled (yellow), facet-labeled (blue), unlabeled (red).", "Text"],

Cell[CellGroupData[{
Cell["Setup", "Section"],

Cell["ClearAll[\"Global`*\"];
$HistoryLength = 0;

qVal = 10;
pList = {2, 3, 4};
sampleSize = 500000;

(* CSV location: prefer sibling ../data/ (repo layout), else fall back to
   NotebookDirectory[] (zip-alongside-CSVs layout). *)
dataDir = With[
  {sibling = FileNameJoin[{ParentDirectory[NotebookDirectory[]], \"data\"}]},
  If[DirectoryQ[sibling], sibling, NotebookDirectory[]]];

(* Paper Figure 2 palette *)
colorVertex    = RGBColor[0.984, 0.757, 0.369];
colorFacet     = RGBColor[0.122, 0.471, 0.706];
colorUnlabeled = RGBColor[0.890, 0.290, 0.200];

seriesColorsTrans = {
  Directive[colorVertex,    Opacity[0.55], EdgeForm[Directive[colorVertex,    AbsoluteThickness[0.4]]]],
  Directive[colorFacet,     Opacity[0.55], EdgeForm[Directive[colorFacet,     AbsoluteThickness[0.4]]]],
  Directive[colorUnlabeled, Opacity[0.55], EdgeForm[Directive[colorUnlabeled, AbsoluteThickness[0.4]]]]};
seriesNames    = {\"vertex-labeled\", \"facet-labeled\", \"unlabeled\"};
legendSwatches = {colorVertex, colorFacet, colorUnlabeled};

frameOpts = Sequence[
  Frame -> True,
  FrameStyle -> Directive[Black, AbsoluteThickness[1]],
  LabelStyle -> Directive[FontFamily -> \"Times\", FontSize -> 11, Black],
  ImageSize -> {360, 270},
  PlotRange -> All,
  ImageMargins -> 5];

panelLabel[p_] := Style[\"p = \" <> ToString[p],
  FontFamily -> \"Times\", FontSize -> 12, Bold];

translucentLegend = SwatchLegend[
  Directive[#, Opacity[0.55]] & /@ legendSwatches,
  seriesNames,
  LegendMarkerSize -> 14,
  LabelStyle -> Directive[FontFamily -> \"Times\", FontSize -> 10, Black]];", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Load sample CSVs", "Section"],

Cell["loadSamples[p_Integer] := Module[{path, raw, headers, body, cols, parseCol},
  path = FileNameJoin[{dataDir,
    \"p\" <> ToString[p] <> \"q\" <> ToString[qVal] <>
    \"_n\" <> ToString[sampleSize] <> \"_samples.csv\"}];
  If[!FileExistsQ[path],
    Print[\"Missing: \", path]; Return[$Failed]];
  Print[\"  loading \", FileNameTake[path]];
  raw = Import[path, \"CSV\"];
  headers = First[raw];
  body    = Rest[raw];
  cols    = Transpose[body];
  parseCol[col_] := Map[Function[x, Which[
    x === \"\", Missing[],
    StringQ[x], N[ToExpression[x]],
    True, x]], col];
  AssociationThread[headers -> (parseCol /@ cols)]];

sampleData = AssociationMap[loadSamples, pList];", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["ESS sanity check", "Section"],

Cell["(* ESS = (Sum w)^2 / Sum w^2 — effective sample size for each weighting.
   Low ESS => reweighted histogram bar heights have high Monte-Carlo variance
   even though total integrated area is still 1. *)
Do[
  Module[{s = sampleData[p], wV, wF, wU, essV, essF, essU, n, fmt},
    wV = s[\"wVertex\"]; wF = s[\"wFacet\"]; wU = s[\"wUnlabeled\"];
    n = Length[wV];
    essV = N[Total[wV]^2 / Total[wV^2]];
    essF = N[Total[wF]^2 / Total[wF^2]];
    essU = N[Total[wU]^2 / Total[wU^2]];
    fmt[ess_] := ToString[Round[ess]] <> \" / \" <> ToString[n] <>
      \" (\" <> ToString[NumberForm[100. ess / n, {4, 3}]] <> \"%)\";
    Print[\"p=\", p, \"  ESS_vertex=\", fmt[essV]];
    Print[\"       ESS_facet =\", fmt[essF]];
    Print[\"       ESS_unlab =\", fmt[essU]]],
  {p, pList}];", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Panel builders", "Section"],

Cell["filterMask[s_, None]        := ConstantArray[True, Length[s[\"numV\"]]];
filterMask[s_, \"connected\"] := (# == 1 &) /@ s[\"connected\"];

extractSeries[s_, col_, filterSpec_] := Module[{mask, vals, wV, wF, wU, keep},
  mask = filterMask[s, filterSpec];
  vals = Pick[s[col], mask];
  wV   = Pick[s[\"wVertex\"], mask];
  wF   = Pick[s[\"wFacet\"], mask];
  wU   = Pick[s[\"wUnlabeled\"], mask];
  keep = (! MissingQ[#]) & /@ vals;
  {Pick[vals, keep], Pick[wV, keep], Pick[wF, keep], Pick[wU, keep]}];

emptyPanel[p_, msg_] := Graphics[
  Text[Style[msg <> \" (p=\" <> ToString[p] <> \")\",
    FontFamily -> \"Times\", FontSize -> 11, Gray]],
  frameOpts];

(* Three panel flavors — all use Histogram with three WeightedData series
   overlaid on the same axes with translucent fill. *)

makePanelDiscrete[p_, col_, xLabel_, filterSpec_:None] := Module[
  {s = sampleData[p], vals, wV, wF, wU, lo, hi},
  {vals, wV, wF, wU} = extractSeries[s, col, filterSpec];
  If[Length[vals] == 0, Return[emptyPanel[p, \"no data\"]]];
  lo = Floor[Min[vals]];
  hi = Ceiling[Max[vals]];
  If[hi <= lo, hi = lo + 1];
  Histogram[
    {WeightedData[vals, wV],
     WeightedData[vals, wF],
     WeightedData[vals, wU]},
    {lo - 0.5, hi + 0.5, 1}, \"PDF\",
    ChartStyle   -> seriesColorsTrans,
    ChartLegends -> Placed[translucentLegend, Top],
    FrameLabel   -> {{\"Probability\", None}, {xLabel, None}},
    PlotLabel    -> panelLabel[p],
    frameOpts]];

makePanelLogBin[p_, col_, xLabel_, filterSpec_:None] := Module[
  {s = sampleData[p], vals, wV, wF, wU, logVals, lo, hi, ticks},
  {vals, wV, wF, wU} = extractSeries[s, col, filterSpec];
  If[Length[vals] == 0, Return[emptyPanel[p, \"no data\"]]];
  logVals = Log10[N[vals]];
  lo = Floor[Min[logVals]];
  hi = Ceiling[Max[logVals]];
  If[hi <= lo, hi = lo + 1];
  ticks = Table[{k + 0.5,
      Style[Superscript[10, k], FontFamily -> \"Times\", FontSize -> 10]},
    {k, lo, hi - 1}];
  Histogram[
    {WeightedData[logVals, wV],
     WeightedData[logVals, wF],
     WeightedData[logVals, wU]},
    {lo, hi, 1}, \"PDF\",
    ChartStyle   -> seriesColorsTrans,
    ChartLegends -> Placed[translucentLegend, Top],
    FrameLabel   -> {{\"Probability per decade\", None}, {xLabel, None}},
    FrameTicks   -> {{Automatic, None}, {ticks, None}},
    PlotLabel    -> panelLabel[p],
    frameOpts]];

makePanelContinuous[p_, col_, xLabel_, filterSpec_:None] := Module[
  {s = sampleData[p], vals, wV, wF, wU},
  {vals, wV, wF, wU} = extractSeries[s, col, filterSpec];
  If[Length[vals] == 0, Return[emptyPanel[p, \"no data\"]]];
  Histogram[
    {WeightedData[vals, wV],
     WeightedData[vals, wF],
     WeightedData[vals, wU]},
    Automatic, \"PDF\",
    ChartStyle   -> seriesColorsTrans,
    ChartLegends -> Placed[translucentLegend, Top],
    FrameLabel   -> {{\"Density\", None}, {xLabel, None}},
    PlotLabel    -> panelLabel[p],
    frameOpts]];

panelDispatch[\"discrete\", args__]    := makePanelDiscrete[args];
panelDispatch[\"logdiscrete\", args__] := makePanelLogBin[args];
panelDispatch[\"continuous\", args__]  := makePanelContinuous[args];

(* Build a 3x1 stacked column for a given statistic across pList (or subset). *)
makeFigure[col_, xLabel_, panelType_, pSubset_:Automatic, filterSpec_:None] := Module[
  {ps, panels},
  ps = If[pSubset === Automatic, pList, pSubset];
  panels = Table[panelDispatch[panelType, p, col, xLabel, filterSpec], {p, ps}];
  GraphicsGrid[List /@ panels,
    Spacings  -> {0.3, 0.3},
    ImageSize -> {380, 290 * Length[ps]}]];", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 3 - Number of vertices", "Section"],
Cell["makeFigure[\"numV\", \"Number of vertices\", \"discrete\"]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 4 - Automorphism group order |Gamma(X)|", "Section"],
Cell["makeFigure[\"aut\", \"|\\[CapitalGamma](X)|\", \"logdiscrete\"]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 5 - Facet-automorphism group order |Gamma_F(X)|", "Section"],
Cell["makeFigure[\"autF\", \"|\\[CapitalGamma]_F(X)|\", \"logdiscrete\"]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 6 - |Gamma(X)| (connected complexes only)", "Section"],
Cell["makeFigure[\"aut\", \"|\\[CapitalGamma](X)|, connected\", \"logdiscrete\", Automatic, \"connected\"]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 7 - |Gamma_F(X)| (connected complexes only)", "Section"],
Cell["makeFigure[\"autF\", \"|\\[CapitalGamma]_F(X)|, connected\", \"logdiscrete\", Automatic, \"connected\"]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 8 - Number of 1-vertex connected components", "Section"],
Cell["makeFigure[\"num1VConnComps\", \"Number of 1-vertex conn. components\", \"discrete\"]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 9 - Number of 2-vertex connected components", "Section"],
Cell["makeFigure[\"num2VConnComps\", \"Number of 2-vertex conn. components\", \"discrete\"]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 10 - Largest-component vertex ratio", "Section"],
Cell["makeFigure[\"largestCompRatio\", \"Largest-component vertex ratio\", \"continuous\"]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 11 - Number of 2-path connected components (p in {3, 4})", "Section"],
Cell["makeFigure[\"num2PathConnComps\", \"Number of 2-path conn. components\", \"discrete\", {3, 4}]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 12 - Number of 3-path connected components (p = 4)", "Section"],
Cell["makeFigure[\"num3PathConnComps\", \"Number of 3-path conn. components\", \"discrete\", {4}]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 13 - First Betti number Beta_1", "Section"],
Cell["makeFigure[\"Betti1\", \"\\[Beta]_1\", \"discrete\"]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 14 - Second Betti number Beta_2 (p in {3, 4})", "Section"],
Cell["makeFigure[\"Betti2\", \"\\[Beta]_2\", \"discrete\", {3, 4}]", "Input"]
}, Open]],

Cell[CellGroupData[{
Cell["Figure 15 - Third Betti number Beta_3 (p = 4)", "Section"],
Cell["makeFigure[\"Betti3\", \"\\[Beta]_3\", \"discrete\", {4}]", "Input"]
}, Open]]

}, WindowSize -> {1100, 800}, FrontEndVersion -> "14.3 for Microsoft Windows (64-bit) (July 8, 2025)", StyleDefinitions -> "Default.nb"]
